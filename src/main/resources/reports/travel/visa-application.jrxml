<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="visa-application" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">
    <parameter name="title" class="java.lang.String"/>
    <parameter name="body" class="java.lang.String"/>
    <title>
        <band height="30">
            <staticText>
                <reportElement x="0" y="0" width="535" height="28"/>
                <textElement textAlignment="Center"><font size="16" isBold="true"/></textElement>
                <text><![CDATA[Visa Application]]></text>
            </staticText>
        </band>
    </title>
    <detail>
        <band height="760" splitAllowed="true">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="535" height="760"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{body}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    <pageFooter>
        <band height="15">
            <textField evaluationTime="Page">
                <reportElement x="435" y="0" width="100" height="15"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
