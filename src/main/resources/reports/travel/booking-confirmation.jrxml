<?xml version="1.0" encoding="UTF-8"?>
<!--
  booking-confirmation.jrxml — SpindleERP Travel Module (JasperReports 7)
  Main dataset  : trv_booking_services lines for one booking ($P{bookingId})
  Sub dataset   : PassengersDS (trv_passengers of the booking)
  Fill          : JasperFillManager.fillReport(jasper, params, jdbcConnection)
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd
                                  http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd"
              name="booking-confirmation"
              pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">


    <!-- ── Sub dataset: passengers of this booking ────────────────────── -->
    <subDataset name="PassengersDS">
        <parameter name="bookingId" class="java.lang.Long"/>
        <queryString><![CDATA[
            SELECT TRIM(COALESCE(p.title,'') || ' ' || p.first_name || ' ' || COALESCE(p.last_name,'')) AS full_name,
                   p.passenger_type,
                   COALESCE(p.passport_number,'-')                    AS passport_number,
                   COALESCE(TO_CHAR(p.passport_expiry,'DD-Mon-YYYY'),'-') AS passport_expiry,
                   COALESCE(p.nationality,'-')                        AS nationality,
                   CASE WHEN p.is_lead_passenger THEN 'LEAD' ELSE '' END AS lead_flag
            FROM   trv_passengers p
            WHERE  p.booking_id = $P{bookingId}
            ORDER  BY p.is_lead_passenger DESC, p.id
        ]]></queryString>
        <field name="full_name"       class="java.lang.String"/>
        <field name="passenger_type"  class="java.lang.String"/>
        <field name="passport_number" class="java.lang.String"/>
        <field name="passport_expiry" class="java.lang.String"/>
        <field name="nationality"     class="java.lang.String"/>
        <field name="lead_flag"       class="java.lang.String"/>
    </subDataset>

    <!-- ── Company / branding ─────────────────────────────────────────── -->
    <parameter name="image_path"      class="java.lang.String"/>
    <parameter name="company_name"    class="java.lang.String"/>
    <parameter name="company_address" class="java.lang.String"/>

    <!-- ── Keys ───────────────────────────────────────────────────────── -->
    <parameter name="bookingId"       class="java.lang.Long"/>

    <!-- ── Header info ────────────────────────────────────────────────── -->
    <parameter name="bookingNo"       class="java.lang.String"/>
    <parameter name="bookingDate"     class="java.lang.String"/>
    <parameter name="bookingType"     class="java.lang.String"/>
    <parameter name="status"          class="java.lang.String"/>
    <parameter name="customer"        class="java.lang.String"/>
    <parameter name="travelPeriod"    class="java.lang.String"/>
    <parameter name="currency"        class="java.lang.String"/>
    <parameter name="salesAgent"      class="java.lang.String"/>
    <parameter name="remarks"         class="java.lang.String"/>

    <!-- ── Totals (header-level figures from trv_bookings) ────────────── -->
    <parameter name="subtotalAmount"  class="java.math.BigDecimal"/>
    <parameter name="discountAmount"  class="java.math.BigDecimal"/>
    <parameter name="taxAmount"       class="java.math.BigDecimal"/>
    <parameter name="totalAmount"     class="java.math.BigDecimal"/>
    <parameter name="paidAmount"      class="java.math.BigDecimal"/>
    <parameter name="dueAmount"       class="java.math.BigDecimal"/>
    <parameter name="amountInWords"   class="java.lang.String"/>

    <queryString><![CDATA[
        SELECT s.service_type,
               COALESCE(s.description, '')                       AS description,
               s.quantity,
               s.unit_price,
               s.discount_amount                                 AS line_discount,
               s.tax_amount                                      AS line_tax,
               s.line_total
        FROM   trv_booking_services s
        WHERE  s.booking_id = $P{bookingId}
        ORDER  BY s.id
    ]]></queryString>

    <field name="service_type"  class="java.lang.String"/>
    <field name="description"   class="java.lang.String"/>
    <field name="quantity"      class="java.math.BigDecimal"/>
    <field name="unit_price"    class="java.math.BigDecimal"/>
    <field name="line_discount" class="java.math.BigDecimal"/>
    <field name="line_tax"      class="java.math.BigDecimal"/>
    <field name="line_total"    class="java.math.BigDecimal"/>

    <title>
        <band height="150">
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="0" y="0" width="180" height="40"/>
                <imageExpression><![CDATA[$P{image_path}]]></imageExpression>
            </image>
            <textField>
                <reportElement x="250" y="0" width="285" height="16"/>
                <textElement textAlignment="Right"  isBold="true"><font size="12"/></textElement>
                <textFieldExpression><![CDATA[$P{company_name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="18" width="285" height="22"/>
                <textElement textAlignment="Right" ><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{company_address}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement mode="Opaque" x="117" y="48" width="300" height="22" backcolor="#2E3192" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"  isBold="true"><font size="12"/></textElement>
                <text><![CDATA[BOOKING CONFIRMATION]]></text>
            </staticText>

            <!-- left column -->
            <textField>
                <reportElement x="0" y="80" width="330" height="14"/>
                <textElement  verticalAlignment="Middle"><font size="9"/></textElement>
                <box><bottomPen lineWidth="0.5" lineStyle="Dotted"/></box>
                <textFieldExpression><![CDATA["Customer : " + $P{customer}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="96" width="330" height="14"/>
                <textElement  verticalAlignment="Middle"><font size="9"/></textElement>
                <box><bottomPen lineWidth="0.5" lineStyle="Dotted"/></box>
                <textFieldExpression><![CDATA["Booking Type : " + $P{bookingType}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="112" width="330" height="14"/>
                <textElement  verticalAlignment="Middle"><font size="9"/></textElement>
                <box><bottomPen lineWidth="0.5" lineStyle="Dotted"/></box>
                <textFieldExpression><![CDATA["Travel Period : " + $P{travelPeriod}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="128" width="330" height="14"/>
                <textElement  verticalAlignment="Middle"><font size="9"/></textElement>
                <box><bottomPen lineWidth="0.5" lineStyle="Dotted"/></box>
                <textFieldExpression><![CDATA["Sales Agent : " + $P{salesAgent}]]></textFieldExpression>
            </textField>

            <!-- right column -->
            <textField>
                <reportElement x="360" y="80" width="175" height="14"/>
                <textElement  isBold="true" verticalAlignment="Middle"><font size="9"/></textElement>
                <box><bottomPen lineWidth="0.5" lineStyle="Dotted"/></box>
                <textFieldExpression><![CDATA["Booking No : " + $P{bookingNo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="360" y="96" width="175" height="14"/>
                <textElement  verticalAlignment="Middle"><font size="9"/></textElement>
                <box><bottomPen lineWidth="0.5" lineStyle="Dotted"/></box>
                <textFieldExpression><![CDATA["Date : " + $P{bookingDate}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="360" y="112" width="175" height="14"/>
                <textElement  verticalAlignment="Middle"><font size="9"/></textElement>
                <box><bottomPen lineWidth="0.5" lineStyle="Dotted"/></box>
                <textFieldExpression><![CDATA["Status : " + $P{status}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="360" y="128" width="175" height="14"/>
                <textElement  verticalAlignment="Middle"><font size="9"/></textElement>
                <box><bottomPen lineWidth="0.5" lineStyle="Dotted"/></box>
                <textFieldExpression><![CDATA["Currency : " + $P{currency}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="18">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="25" height="18" backcolor="#2E3192" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"  isBold="true"><font size="8"/></textElement>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <text><![CDATA[SL]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="25" y="0" width="65" height="18" backcolor="#2E3192" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"  isBold="true"><font size="8"/></textElement>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <text><![CDATA[Service]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="90" y="0" width="185" height="18" backcolor="#2E3192" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"  isBold="true"><font size="8"/></textElement>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <text><![CDATA[Description]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="275" y="0" width="45" height="18" backcolor="#2E3192" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"  isBold="true"><font size="8"/></textElement>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <text><![CDATA[Qty]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="320" y="0" width="70" height="18" backcolor="#2E3192" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"  isBold="true"><font size="8"/></textElement>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <text><![CDATA[Unit Price]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="390" y="0" width="45" height="18" backcolor="#2E3192" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"  isBold="true"><font size="8"/></textElement>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <text><![CDATA[Disc.]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="435" y="0" width="40" height="18" backcolor="#2E3192" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"  isBold="true"><font size="8"/></textElement>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <text><![CDATA[Tax]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="475" y="0" width="60" height="18" backcolor="#2E3192" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"  isBold="true"><font size="8"/></textElement>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <text><![CDATA[Line Total]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16">
            <textField>
                <reportElement x="0" y="0" width="25" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle" ><font size="8"/></textElement>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="25" y="0" width="65" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle" ><font size="8"/></textElement>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textFieldExpression><![CDATA[$F{service_type}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="90" y="0" width="185" height="16"/>
                <textElement verticalAlignment="Middle" ><font size="8"/></textElement>
                <box leftPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.###">
                <reportElement x="275" y="0" width="45" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle" ><font size="8"/></textElement>
                <box rightPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="320" y="0" width="70" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle" ><font size="8"/></textElement>
                <box rightPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textFieldExpression><![CDATA[$F{unit_price}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="390" y="0" width="45" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle" ><font size="8"/></textElement>
                <box rightPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textFieldExpression><![CDATA[$F{line_discount}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="435" y="0" width="40" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle" ><font size="8"/></textElement>
                <box rightPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textFieldExpression><![CDATA[$F{line_tax}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="475" y="0" width="60" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle" ><font size="8"/></textElement>
                <box rightPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textFieldExpression><![CDATA[$F{line_total}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="278">
            <!-- ── Passenger manifest ─────────────────────────────────── -->
            <staticText>
                <reportElement mode="Opaque" x="0" y="8" width="535" height="16" backcolor="#EEEEF7"/>
                <textElement verticalAlignment="Middle"  isBold="true"><font size="9"/></textElement>
                <box leftPadding="3"><pen lineWidth="0.25" lineColor="#2E3192"/></box>
                <text><![CDATA[PASSENGERS]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="24" width="25" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"  isBold="true"><font size="8"/></textElement>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <text><![CDATA[#]]></text>
            </staticText>
            <staticText>
                <reportElement x="25" y="24" width="175" height="14"/>
                <textElement verticalAlignment="Middle"  isBold="true"><font size="8"/></textElement>
                <box leftPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <text><![CDATA[Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="200" y="24" width="55" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"  isBold="true"><font size="8"/></textElement>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <text><![CDATA[Type]]></text>
            </staticText>
            <staticText>
                <reportElement x="255" y="24" width="105" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"  isBold="true"><font size="8"/></textElement>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <text><![CDATA[Passport No]]></text>
            </staticText>
            <staticText>
                <reportElement x="360" y="24" width="75" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"  isBold="true"><font size="8"/></textElement>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <text><![CDATA[Expiry]]></text>
            </staticText>
            <staticText>
                <reportElement x="435" y="24" width="65" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"  isBold="true"><font size="8"/></textElement>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <text><![CDATA[Nationality]]></text>
            </staticText>
            <staticText>
                <reportElement x="500" y="24" width="35" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"  isBold="true"><font size="8"/></textElement>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <text><![CDATA[Lead]]></text>
            </staticText>
            <componentElement>
                <reportElement x="0" y="38" width="535" height="14" positionType="Float"/>
                <jr:list printOrder="Vertical">
                    <datasetRun subDataset="PassengersDS">
                        <datasetParameter name="bookingId">
                            <datasetParameterExpression><![CDATA[$P{bookingId}]]></datasetParameterExpression>
                        </datasetParameter>
                        <connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
                    </datasetRun>
                    <jr:listContents height="14" width="535">
                        <textField>
                            <reportElement x="0" y="0" width="25" height="14"/>
                            <textElement textAlignment="Center" verticalAlignment="Middle" ><font size="8"/></textElement>
                            <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                            <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
                        </textField>
                        <textField>
                            <reportElement x="25" y="0" width="175" height="14"/>
                            <textElement verticalAlignment="Middle" ><font size="8"/></textElement>
                            <box leftPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                            <textFieldExpression><![CDATA[$F{full_name}]]></textFieldExpression>
                        </textField>
                        <textField>
                            <reportElement x="200" y="0" width="55" height="14"/>
                            <textElement textAlignment="Center" verticalAlignment="Middle" ><font size="8"/></textElement>
                            <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                            <textFieldExpression><![CDATA[$F{passenger_type}]]></textFieldExpression>
                        </textField>
                        <textField>
                            <reportElement x="255" y="0" width="105" height="14"/>
                            <textElement textAlignment="Center" verticalAlignment="Middle" ><font size="8"/></textElement>
                            <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                            <textFieldExpression><![CDATA[$F{passport_number}]]></textFieldExpression>
                        </textField>
                        <textField>
                            <reportElement x="360" y="0" width="75" height="14"/>
                            <textElement textAlignment="Center" verticalAlignment="Middle" ><font size="8"/></textElement>
                            <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                            <textFieldExpression><![CDATA[$F{passport_expiry}]]></textFieldExpression>
                        </textField>
                        <textField>
                            <reportElement x="435" y="0" width="65" height="14"/>
                            <textElement textAlignment="Center" verticalAlignment="Middle" ><font size="8"/></textElement>
                            <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                            <textFieldExpression><![CDATA[$F{nationality}]]></textFieldExpression>
                        </textField>
                        <textField>
                            <reportElement x="500" y="0" width="35" height="14"/>
                            <textElement textAlignment="Center" verticalAlignment="Middle"  isBold="true"><font size="8"/></textElement>
                            <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                            <textFieldExpression><![CDATA[$F{lead_flag}]]></textFieldExpression>
                        </textField>
                    </jr:listContents>
                </jr:list>
            </componentElement>

            <!-- ── Totals block (right) + amount in words (left) ──────── -->
            <textField>
                <reportElement x="0" y="62" width="300" height="28" positionType="Float"/>
                <textElement ><font size="8"/></textElement>
                <textFieldExpression><![CDATA["In Words : " + $P{amountInWords}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="94" width="300" height="28" positionType="Float"/>
                <textElement ><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Remarks : " + $P{remarks}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="340" y="58" width="110" height="14" positionType="Float"/>
                <textElement textAlignment="Right" ><font size="9"/></textElement>
                <text><![CDATA[Subtotal :]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="450" y="58" width="85" height="14" positionType="Float"/>
                <textElement textAlignment="Right" ><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{subtotalAmount}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="340" y="72" width="110" height="14" positionType="Float"/>
                <textElement textAlignment="Right" ><font size="9"/></textElement>
                <text><![CDATA[Discount :]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="450" y="72" width="85" height="14" positionType="Float"/>
                <textElement textAlignment="Right" ><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{discountAmount}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="340" y="86" width="110" height="14" positionType="Float"/>
                <textElement textAlignment="Right" ><font size="9"/></textElement>
                <text><![CDATA[Tax :]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="450" y="86" width="85" height="14" positionType="Float"/>
                <textElement textAlignment="Right" ><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{taxAmount}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement mode="Opaque" x="340" y="100" width="110" height="16" backcolor="#EEEEF7" positionType="Float"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"  isBold="true"><font size="10"/></textElement>
                <box><topPen lineWidth="0.75"/></box>
                <text><![CDATA[Total :]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement mode="Opaque" x="450" y="100" width="85" height="16" backcolor="#EEEEF7" positionType="Float"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"  isBold="true"><font size="10"/></textElement>
                <box rightPadding="2"><topPen lineWidth="0.75"/></box>
                <textFieldExpression><![CDATA[$P{totalAmount}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="340" y="116" width="110" height="14" positionType="Float"/>
                <textElement textAlignment="Right" ><font size="9"/></textElement>
                <text><![CDATA[Paid :]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="450" y="116" width="85" height="14" positionType="Float"/>
                <textElement textAlignment="Right" ><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{paidAmount}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="340" y="130" width="110" height="14" positionType="Float"/>
                <textElement textAlignment="Right"  isBold="true"><font size="9"/></textElement>
                <text><![CDATA[Due :]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="450" y="130" width="85" height="14" positionType="Float"/>
                <textElement textAlignment="Right"  isBold="true"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{dueAmount}]]></textFieldExpression>
            </textField>

            <!-- ── Signatures ─────────────────────────────────────────── -->
            <staticText>
                <reportElement x="0" y="250" width="120" height="12" positionType="Float"/>
                <textElement textAlignment="Center" ><font size="8"/></textElement>
                <box><topPen lineWidth="0.5"/></box>
                <text><![CDATA[Prepared by]]></text>
            </staticText>
            <staticText>
                <reportElement x="140" y="250" width="120" height="12" positionType="Float"/>
                <textElement textAlignment="Center" ><font size="8"/></textElement>
                <box><topPen lineWidth="0.5"/></box>
                <text><![CDATA[Customer]]></text>
            </staticText>
            <staticText>
                <reportElement x="280" y="250" width="120" height="12" positionType="Float"/>
