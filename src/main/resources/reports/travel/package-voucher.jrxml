<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="package-voucher" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
    <parameter name="title" class="java.lang.String"/>
    <parameter name="package_code" class="java.lang.String"/>
    <parameter name="package_name" class="java.lang.String"/>
    <parameter name="destination" class="java.lang.String"/>
    <parameter name="duration_days" class="java.lang.Integer"/>
    <parameter name="duration_nights" class="java.lang.Integer"/>
    <parameter name="base_price" class="java.math.BigDecimal"/>
    <parameter name="currency" class="java.lang.String"/>
    <parameter name="description" class="java.lang.String"/>
    <parameter name="travel_date" class="java.lang.String"/>
    <parameter name="pax_count" class="java.lang.Integer"/>
    <parameter name="total_amount" class="java.math.BigDecimal"/>
    <parameter name="confirmation_number" class="java.lang.String"/>
    <parameter name="status" class="java.lang.String"/>
    <parameter name="itinerarySubreport" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
    <parameter name="inclusionsSubreport" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
    <parameter name="itineraryDataSource" class="net.sf.jasperreports.engine.data.JRBeanCollectionDataSource"/>
    <parameter name="inclusionsDataSource" class="net.sf.jasperreports.engine.data.JRBeanCollectionDataSource"/>

    <title>
        <band height="60">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center"><font size="18" isBold="true"/></textElement>
                <text><![CDATA[Package Voucher]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="32" width="555" height="20"/>
                <textElement textAlignment="Center"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{package_name}]]></textFieldExpression>
            </textField>
            <line><reportElement x="0" y="58" width="555" height="1"/></line>
        </band>
    </title>

    <columnHeader>
        <band height="70">
            <textField>
                <reportElement x="0" y="0" width="120" height="15"/>
                <textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Package Code:]]></text>
            </textField>
            <textField>
                <reportElement x="120" y="0" width="150" height="15"/>
                <textFieldExpression><![CDATA[$P{package_code}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="16" width="120" height="15"/>
                <textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Destination:]]></text>
            </textField>
            <textField>
                <reportElement x="120" y="16" width="150" height="15"/>
                <textFieldExpression><![CDATA[$P{destination}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="32" width="120" height="15"/>
                <textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Duration:]]></text>
            </textField>
            <textField>
                <reportElement x="120" y="32" width="150" height="15"/>
                <textFieldExpression><![CDATA[$P{duration_days} + " Days / " + $P{duration_nights} + " Nights"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="300" y="0" width="100" height="15"/>
                <textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Travel Date:]]></text>
            </textField>
            <textField>
                <reportElement x="400" y="0" width="155" height="15"/>
                <textFieldExpression><![CDATA[$P{travel_date}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="300" y="16" width="100" height="15"/>
                <textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Pax:]]></text>
            </textField>
            <textField>
                <reportElement x="400" y="16" width="155" height="15"/>
                <textFieldExpression><![CDATA[$P{pax_count} != null ? String.valueOf($P{pax_count}) : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="300" y="32" width="100" height="15"/>
                <textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Confirmation:]]></text>
            </textField>
            <textField>
                <reportElement x="400" y="32" width="155" height="15"/>
                <textFieldExpression><![CDATA[$P{confirmation_number}]]></textFieldExpression>
            </textField>
        </band>
    </columnHeader>

    <detail>
        <band height="360">
            <!-- Description -->
            <textField>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement><font size="8" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{description} != null ? $P{description} : ""]]></textFieldExpression>
            </textField>

            <!-- Itinerary -->
            <staticText>
                <reportElement x="0" y="35" width="555" height="18"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Itinerary]]></text>
            </staticText>
            <frame>
                <reportElement x="0" y="53" width="555" height="18" backcolor="#F0F0F0"/>
                <staticText><reportElement x="0" y="0" width="50" height="18"/><box><rightPen width="0.5"/></box><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Day]]></text></staticText>
                <staticText><reportElement x="50" y="0" width="200" height="18"/><box><rightPen width="0.5"/></box><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Title]]></text></staticText>
                <staticText><reportElement x="250" y="0" width="305" height="18"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
            </frame>
            <subreport>
                <reportElement x="0" y="71" width="555" height="80"/>
                <dataSourceExpression><![CDATA[$P{itineraryDataSource}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{itinerarySubreport}]]></subreportExpression>
            </subreport>

            <!-- Inclusions -->
            <staticText>
                <reportElement x="0" y="160" width="555" height="18"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Inclusions / Exclusions]]></text>
            </staticText>
            <frame>
                <reportElement x="0" y="178" width="555" height="18" backcolor="#F0F0F0"/>
                <staticText><reportElement x="0" y="0" width="80" height="18"/><box><rightPen width="0.5"/></box><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Type]]></text></staticText>
                <staticText><reportElement x="80" y="0" width="475" height="18"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
            </frame>
            <subreport>
                <reportElement x="0" y="196" width="555" height="60"/>
                <dataSourceExpression><![CDATA[$P{inclusionsDataSource}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{inclusionsSubreport}]]></subreportExpression>
            </subreport>

            <!-- Pricing Summary -->
            <staticText>
                <reportElement x="0" y="270" width="555" height="18"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Pricing]]></text>
            </staticText>
            <line>
                <reportElement x="350" y="295" width="205" height="0"/>
            </line>
            <textField>
                <reportElement x="350" y="298" width="100" height="18"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Total Amount:]]></text>
            </textField>
            <textField>
                <reportElement x="450" y="298" width="105" height="18"/>
                <textElement textAlignment="Right"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{currency} + " " + ($P{total_amount} != null ? $P{total_amount}.toPlainString() : "0")]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <line><reportElement x="0" y="0" width="555" height="1"/></line>
            <textField evaluationTime="Report">
                <reportElement x="0" y="2" width="300" height="15"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Generated by Spindle ERP — Travel Module"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Page">
                <reportElement x="450" y="2" width="105" height="15"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
